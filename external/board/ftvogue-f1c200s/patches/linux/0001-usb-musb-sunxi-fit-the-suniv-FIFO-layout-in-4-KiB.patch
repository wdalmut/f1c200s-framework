From: f1c200s-framework <noreply@localhost>
Subject: [PATCH] usb: musb: sunxi: fit the suniv FIFO layout in 4 KiB

The F1C100s/F1C200s OTG FIFO is SRAM D, 4 KiB, but suniv uses the 5eps
layout (64 + 10 * 512 = 5184 bytes) with ram_bits = 11 (8 KiB). Moreover
only EP1..EP3 work: in host mode behind a LAN9512 hub, transfers scheduled
on EP4 or EP5 never complete, at any FIFO offset (smsc95xx bulk-in on EP4
RX, then the hub and smsc95xx interrupt-in on EP4/EP5, then the smsc95xx
bulk endpoints on EP4 at 1344..2367), while EP2/EP3 work at the same
offsets.

Give suniv its own layout with three endpoints: EP1 512-byte pair (musb's
bulk_ep, bulk endpoints are multiplexed on it) and two 64-byte pairs for
the two periodic slots, 1344 bytes.

---
--- a/drivers/usb/musb/sunxi.c	2026-11-28 14:23:37.104500238 +0100
+++ b/drivers/usb/musb/sunxi.c	2026-11-28 14:23:47.092852222 +0100
@@ -674,6 +674,37 @@
 	.ram_bits	= SUNXI_MUSB_RAM_BITS,
 };
 
+/*
+ * F1C100s/F1C200s (suniv): only EP1..EP3 work besides ep0. In host mode
+ * behind the EGARE LAN9512 hub, transfers scheduled on EP4 or EP5 never
+ * complete, whatever their FIFO offset (bulk-in at 3648, interrupt-in at
+ * 3200 and 3328, bulk at 1344..2367 all fail; EP2/EP3 work at the same
+ * offsets). The 5eps layout also overflows the 4 KiB SRAM D (5184 bytes).
+ *
+ * EP1 is musb's bulk_ep: every bulk endpoint is multiplexed on it. EP2 and
+ * EP3 are the two periodic slots, taken by the hub's status endpoint and
+ * the smsc95xx interrupt endpoint: 64 + 2 * 512 + 4 * 64 = 1344 bytes.
+ */
+static struct musb_fifo_cfg sunxi_musb_mode_cfg_suniv[] = {
+	MUSB_EP_FIFO_SINGLE(1, FIFO_TX, 512),
+	MUSB_EP_FIFO_SINGLE(1, FIFO_RX, 512),
+	MUSB_EP_FIFO_SINGLE(2, FIFO_TX, 64),
+	MUSB_EP_FIFO_SINGLE(2, FIFO_RX, 64),
+	MUSB_EP_FIFO_SINGLE(3, FIFO_TX, 64),
+	MUSB_EP_FIFO_SINGLE(3, FIFO_RX, 64),
+};
+
+static const struct musb_hdrc_config sunxi_musb_hdrc_config_suniv = {
+	.fifo_cfg       = sunxi_musb_mode_cfg_suniv,
+	.fifo_cfg_size  = ARRAY_SIZE(sunxi_musb_mode_cfg_suniv),
+	.multipoint	= true,
+	.dyn_fifo	= true,
+	/* Two FIFOs per endpoint, plus ep_0. */
+	.num_eps	= (ARRAY_SIZE(sunxi_musb_mode_cfg_suniv) / 2) + 1,
+	/* 1 << (10 + 2) = 4 KiB */
+	.ram_bits	= 10,
+};
+
 static int sunxi_musb_probe(struct platform_device *pdev)
 {
 	struct musb_hdrc_platform_data	pdata;
@@ -834,7 +865,7 @@
 };
 
 static const struct sunxi_musb_cfg suniv_f1c100s_musb_cfg = {
-	.hdrc_config = &sunxi_musb_hdrc_config_5eps,
+	.hdrc_config = &sunxi_musb_hdrc_config_suniv,
 	.has_sram = true,
 	.has_reset = true,
 	.no_configdata = true,
