//
// EGARE F1C200S: la Lctech Pi F1C200s piu' le differenze della board.
// Tutto il resto (uart1, SPI NAND su spi0, mmc0, USB OTG) viene dal DTS
// Lctech incluso qui sotto: le due board devono restare confrontabili.
// La console invece e' su uart0 (PE0/PE1), non su uart1: vedi aliases.
//
// EEPROM ST M24C02-FMN su i2c0: SCK su PE11 (pin 38 del QFN88), SDA su
// PE12 (pin 37), E0-E2 a GND -> 0x50. Verificata il 2026-11-27 con un DTB
// di prova: i2cdump legge 256 byte, i2cset/i2cget scrivono e rileggono.

/dts-v1/;
#include "suniv-f1c200s-lctech-pi.dts"

/ {
	model = "EGARE F1C200S";

	/*
	 * La console e' la UART0 del connettore SODIMM (pin 205/207), come
	 * vuole la specifica del pinout: sulla SoM sono uart0 su PE0/PE1. Il
	 * DTS Lctech mette serial0 = &uart1 (PA2/PA3), che qui e' la UART1 del
	 * connettore (pin 180/182, la porta RS-485). Alias = numero del
	 * connettore: ttyS0 console, ttyS1 UART1. stdout-path "serial0" viene
	 * dal DTS Lctech e segue l'alias.
	 */
	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		/*
		 * Numeri di bus fissi. spi0 e' la SPI NAND, e i bootargs NAND la
		 * chiamano "mtdparts=spi0.0": senza alias, con spi1 attivo il numero
		 * dipenderebbe dall'ordine di probe. spi1 e' la SPI0 del connettore.
		 */
		spi0 = &spi0;
		spi1 = &spi1;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		/* ETH0 del connettore: il MAC viene dall'EEPROM (cella mac_eth0) */
		ethernet0 = &ethernet;
	};
};

/*
 * I2C1 del connettore (pin 170/172, per la specifica il touch del pannello):
 * i2c1 su PD5 (SCK) / PD6 (SDA). Pull-up 4k7 sulla SoM (R26, R17).
 */
&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pd_pins>;
	status = "okay";
};

/*
 * I2C2 del connettore (pin 174/176, per la specifica il sensore camera):
 * i2c2 su PD15 (SCK) / PD16 (SDA). Pull-up 4k7 sulla SoM (R27, R18).
 */
&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pd_pins>;
	status = "okay";
};

/*
 * SPI0 del connettore (pin 148-154) = spi1 del SoC, su PE9 (CLK), PE8
 * (MOSI), PE10 (MISO), PE7 (CS0). spi0 del SoC resta interno alla SoM per
 * la SPI NAND di boot, come vuole la specifica. In Linux e' il bus 1. Le
 * periferiche le dichiara la carrier che le monta: qui solo il bus.
 */
&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pe_pins>;
	status = "okay";
};

/*
 * UART2 del connettore (pin 190/192): solo TX/RX, come da specifica. Sulla
 * SoM e' uart2 su PD13 (TX) / PD14 (RX). Le alternative non vanno: PD15/
 * PD16 (RTS/CTS di uart2) sono I2C2, PE7-PE10 sono spi1 (SPI0 del
 * connettore).
 */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pd_pins>;
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pe_pins>;
	status = "okay";
};

/*
 * UART1 del connettore (pin 180-186): TX, RX, RTS, CTS. Sulla SoM sono
 * PA2/PA3 piu' PA0 (RTS) e PA1 (CTS), tutti con la funzione uart1. Il DTS
 * Lctech mette solo PA2/PA3. Per la specifica RTS serve tipicamente a
 * pilotare il DE di un transceiver RS-485 sulla carrier: la modalita'
 * RS-485 non si accende qui ma da userspace (ioctl TIOCSRS485; 8250_dw la
 * emula via software se la UART non la ha in hardware) o nel DT di una
 * carrier che monta il transceiver.
 */
&uart1 {
	pinctrl-0 = <&uart1_pa_rtscts_pins>;
	uart-has-rtscts;
};

/*
 * PWM0 del connettore (pin 210) = canale 1 del PWM del SoC, su PE6 (schema
 * SoM: label PWM1). Il canale non si rinumera: il kernel non ha alias per
 * la PWM, e i canali sono fissi nell'hardware. Da Linux e' pwmchip0
 * canale 1, nel DT di una carrier <&pwm 1 periodo polarita'>. Il canale 0
 * non e' sul connettore e non e' muxato.
 */
&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm1_pe_pins>;
	status = "okay";
};

&pio {
	/*
	 * Nomi delle linee (gpioinfo, gpioset -c gpiochip0 GPIO3=1). Indice =
	 * banco * 32 + pin, da PA0: i GPIO0..7 del connettore SODIMM (pin
	 * 223-241) e i segnali della SoM che sono GPIO puri. GPIO8..19 non
	 * sono popolati su questa SoM.
	 */
	gpio-line-names =
		"", "", "", "", "", "", "", "",	/* PA0-PA7 */
		"", "", "", "", "", "", "", "",	/* PA8-PA15 */
		"", "", "", "", "", "", "", "",	/* PA16-PA23 */
		"", "", "", "", "", "", "", "",	/* PA24-PA31 */
		"", "", "", "", "", "", "", "",	/* PB0-PB7 */
		"", "", "", "", "", "", "", "",	/* PB8-PB15 */
		"", "", "", "", "", "", "", "",	/* PB16-PB23 */
		"", "", "", "", "", "", "", "",	/* PB24-PB31 */
		"", "", "", "", "", "", "", "",	/* PC0-PC7 */
		"", "", "", "", "", "", "", "",	/* PC8-PC15 */
		"", "", "", "", "", "", "", "",	/* PC16-PC23 */
		"", "", "", "", "", "", "", "",	/* PC24-PC31 */
		"GPIO0", "GPIO1", "GPIO2", "GPIO3", "GPIO4", "", "", "",	/* PD0-PD7 */
		"", "", "", "", "", "", "", "",	/* PD8-PD15 */
		"", "GPIO5", "GPIO6", "GPIO7", "", "SD0_CD#", "", "",	/* PD16-PD23 */
		"", "", "", "", "", "", "", "",	/* PD24-PD31 */
		"", "", "USB0_VBUS", "USB0_ID", "USB_SEL";	/* PE0-PE4 */

	pwm1_pe_pins: pwm1-pe-pins {
		pins = "PE6";
		function = "pwm1";
	};

	uart1_pa_rtscts_pins: uart1-pa-rtscts-pins {
		pins = "PA0", "PA1", "PA2", "PA3";
		function = "uart1";
	};

	uart2_pd_pins: uart2-pd-pins {
		pins = "PD13", "PD14";
		function = "uart2";
	};

	i2c1_pd_pins: i2c1-pd-pins {
		pins = "PD5", "PD6";
		function = "i2c1";
	};

	i2c2_pd_pins: i2c2-pd-pins {
		pins = "PD15", "PD16";
		function = "i2c2";
	};

	spi1_pe_pins: spi1-pe-pins {
		pins = "PE7", "PE8", "PE9", "PE10";
		function = "spi1";
	};

	/* Il .dtsi definisce i2c0 solo su PD0/PD12. */
	i2c0_pe_pins: i2c0-pe-pins {
		pins = "PE11", "PE12";
		function = "i2c0";
	};

	/*
	 * USB_SEL (PE4) pilota i mux FSUSB42 U6/U7 e il gate di Q2.
	 * Alto: CPU -> upstream del LAN9512 (hub + Ethernet), connettore OTG
	 * sulla porta 2 dell'hub, USB0_ID a massa. Basso (default, pull-down
	 * sulla SoM): CPU diretta sul connettore OTG, come serve alla BROM
	 * per il FEL. Linux lo tiene alto: la USB della CPU e' solo host.
	 */
	usb-sel-hog {
		gpio-hog;
		gpios = <4 4 GPIO_ACTIVE_HIGH>;	/* PE4 */
		output-high;
		line-name = "usb-sel";
	};
};

/*
 * Il DTS Lctech la mette in peripheral; qui dietro c'e' l'hub LAN9512, sulla
 * porta 1 del root hub, con l'Ethernet sulla sua porta 1 (come sul Raspberry
 * Pi B). Il nodo serve a dare all'Ethernet il MAC dell'EEPROM: smsc95xx lo
 * legge da nvmem-cells (Linux scarta FF..FF, zero e multicast, ma non
 * controlla magic e CRC del record). Senza, MAC casuale a ogni avvio.
 */
&usb_otg {
	dr_mode = "host";
	#address-cells = <1>;
	#size-cells = <0>;

	hub@1 {
		compatible = "usb424,9512";
		reg = <1>;
		#address-cells = <1>;
		#size-cells = <0>;

		ethernet: ethernet@1 {
			compatible = "usb424,ec00";
			reg = <1>;
			nvmem-cells = <&mac_eth0>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pe_pins>;
	status = "okay";

	eeprom@50 {
		compatible = "st,24c02", "atmel,24c02";
		reg = <0x50>;
		pagesize = <16>;

		/*
		 * Record di identificazione del modulo, schema v1.0
		 * (docs/EEPROM-ID.md). mac_eth0 la usa l'Ethernet del LAN9512;
		 * ETH1 non c'e' su questa board. Le altre celle sono per
		 * userspace. Niente read-only: la produzione scrive da Linux con
		 * som-id.
		 */
		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			som-id@0 { reg = <0x00 0x40>; };
			mac_eth0: mac-address@10 { reg = <0x10 0x06>; };
			mac-address@16 { reg = <0x16 0x06>; };
			serial-number@1c { reg = <0x1c 0x0c>; };
		};
	};
};
