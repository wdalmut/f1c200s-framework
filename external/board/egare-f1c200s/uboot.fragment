#
# Frammento EGARE, applicato DOPO ../ftvogue-f1c200s/uboot.fragment: U-Boot
# e' lo stesso della FTVOGUE (DT di U-Boot compreso), cambia solo il DTB
# che il bootcmd passa al kernel, in entrambi i rami.
#
# La riga e' una copia di quella FTVOGUE con il nome del DTB sostituito.
# La CI (checks.yml) verifica che resti tale: se cambi il bootcmd FTVOGUE,
# cambia anche questo.
CONFIG_BOOTCOMMAND="if test -e mmc 0:1 zImage; then echo boot: SD; setenv bootargs \"console=ttyS0,115200 earlyprintk root=/dev/mmcblk0p2 rootwait rw\"; load mmc 0:1 0x80008000 zImage && load mmc 0:1 0x81800000 suniv-f1c200s-egare.dtb; else echo boot: NAND; setenv bootargs \"console=ttyS0,115200 earlyprintk mtdparts=spi0.0:1M(boot),-(ubi) ubi.mtd=ubi root=ubi0:rootfs rootfstype=ubifs rw\"; ubi part ubi && ubifsmount ubi0:rootfs && ubifsload 0x80008000 /boot/zImage && ubifsload 0x81800000 /boot/suniv-f1c200s-egare.dtb; fi && bootz 0x80008000 - 0x81800000"
